          "raw": "{\n  \"title\": \"Valid Title Here\",\n  \"category\": \"Borrowing\",\n  \"description\": \"Valid description exceeding five characters.\",\n  \"status\": \"Pending\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/records/999999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "records", "999999"]
