# Port for Express server
PORT=3000

# PostgreSQL Connection String (Neon, Supabase, Render, or local PostgreSQL)
# Example: postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/library_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/library_db

# Allowed Frontend Origins for CORS (comma-separated, no trailing slashes)
CLIENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-frontend.netlify.app
